{
  "name": "Learning-Plugin",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "dist/code.js",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:main": "vite build --config vite.config.main.ts",
    "build:ui": "vite build --config vite.config.ui.mts",
    "build:tokens": "tz build && node scripts/build-token-preview.mjs",
    "build": "npm run clean && npm run build:tokens && npm run typecheck && npm run build:main && npm run build:ui",
    "watch:main": "vite build --config vite.config.main.ts --watch",
    "watch:ui": "vite build --config vite.config.ui.mts --watch",
    "watch": "concurrently -n main,ui -c blue,green \"npm:watch:main\" \"npm:watch:ui\"",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/token-tools": "^2.7.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-storybook": "^10.5.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "postcss-scss": "^4.0.9",
    "sass": "^1.102.0",
    "storybook": "^10.5.5",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-csstree-validator": "^4.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@autoform/react": "^5.0.0",
    "@autoform/zod": "^6.0.0",
    "@hookform/resolvers": "^5.9.2",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  }
}
