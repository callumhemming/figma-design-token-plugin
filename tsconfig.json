{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/ui.tsx",
    "src/app/**/*",
    "src/components/**/*",
    "scss-modules.d.ts"
  ],
  "exclude": ["**/*.stories.*", "**/*.test.*", "**/*.spec.*"]
}
