{
  "p": {
    "color": {
      "white": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "transparent": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 0
        }
      },
      "amber": {
        "contrast": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1294, 0.1255, 0.1098],
            "hex": "#21201c"
          },
          "$description": "Text on amber.9/10. Amber's solid steps are light in both themes, so they need dark text (Radix's amber contrast colour)."
        }
      }
    }
  }
}
