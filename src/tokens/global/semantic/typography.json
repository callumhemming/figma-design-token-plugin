      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{p.font-family.sans}",
          "fontSize": "{p.font-size.step-n2}",
          "fontWeight": "{p.font-weight.regular}",
          "lineHeight": "{p.line-height.snug}",
