{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "sets": {
    "primitives": {
      "sources": [
        { "$ref": "global/primitives/color.json" },
        { "$ref": "global/primitives/spacing.json" },
        { "$ref": "global/primitives/viewport.json" },
        { "$ref": "global/primitives/radius.json" },
        { "$ref": "global/primitives/border-width.json" },
        { "$ref": "global/primitives/typography.json" }
      ]
    },
    "semantic": {
      "sources": [
        { "$ref": "global/semantic/color.json" },
        { "$ref": "global/semantic/spacing.json" },
        { "$ref": "global/semantic/radius.json" },
        { "$ref": "global/semantic/border-width.json" },
        { "$ref": "global/semantic/typography.json" }
      ]
    },
    "component": {
      "sources": [
        { "$ref": "global/component/button.json" },
        { "$ref": "global/component/form-input.json" },
        { "$ref": "global/component/input.json" },
        { "$ref": "global/component/checkbox.json" }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Swaps the Radix primitive scales. Steps mean the same thing in both themes, so semantic and component tokens are shared.",
      "contexts": {
        "light": [{ "$ref": "global/primitives/color.light.json" }],
        "dark": [{ "$ref": "global/primitives/color.dark.json" }]
      },
      "default": "light"
    },
    "platform": {
      "contexts": {
        "web": [{ "$ref": "global/primitives/font-family.web.json" }],
        "native": [{ "$ref": "global/primitives/font-family.native.json" }]
      },
      "default": "web"
    },
    "brand": {
      "description": "Maps the primary/secondary/accent semantic roles onto Radix hues. Every brand must define the same s.color.* paths.",
      "contexts": {
        "acme": [{ "$ref": "brands/acme/semantic/color.json" }],
        "globex": [{ "$ref": "brands/globex/semantic/color.json" }]
      },
      "default": "acme"
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/primitives" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/modifiers/platform" },
    { "$ref": "#/sets/semantic" },
    { "$ref": "#/modifiers/brand" },
    { "$ref": "#/sets/component" }
  ]
}
